# ==============================================================================
# Variables d'environnement pour Touba Gaz IT (Production / Railpack / Docker)
# ==============================================================================

# 1. Base de données MySQL principale (Obligatoire)
DATABASE_URL="mysql://utilisateur:mot_de_passe@hote:3306/nom_de_base"

# Paramètres optionnels si non spécifiés dans DATABASE_URL
DB_HOST=145.223.33.29
DB_PORT=3306
DB_NAME=default
DB_USER=mysql
DB_PASSWORD=

# 2. Clé secrète de session (Obligatoire en production - min 32 caractères)
SESSION_SECRET=votre-cle-secrete-aleatoire-tres-longue-et-securisee

# 3. Stockage d'images Zipline (Optionnel - fallback local automatique si absent)
ZIPLINE_URL=https://zipline.touba-app.com
ZIPLINE_TOKEN=

# 4. Configuration serveur Node.js (Optionnel)
NODE_ENV=production
PORT=3000
